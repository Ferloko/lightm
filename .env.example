# Supabase / Vite — configure these in Vercel Environment Variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: local demo without Supabase in a preview/production build (never in production).
# VITE_ENABLE_DEMO=true

# Facebrowser (red social de GTA World). Sin estas variables, "Facebrowser" se muestra sin enlace.
# VITE_FACEBROWSER_URL=https://direccion-de-facebrowser   # base para convertir @usuario en enlace
# VITE_FACEBROWSER_LIGHT_PAGE=https://...                 # perfil de LIGHT (pie de página)
