# Supabase / Vite — configure these in Vercel Environment Variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: local demo without Supabase in a preview/production build (never in production).
# VITE_ENABLE_DEMO=true

# Facebrowser (red social de GTA World). Opcional: los valores por defecto ya apuntan a face-es.gta.world.
# VITE_FACEBROWSER_URL=https://face-es.gta.world   # base: @usuario → /profile/usuario (valor por defecto)
# VITE_FACEBROWSER_LIGHT_PAGE=https://face-es.gta.world/page/light   # perfil de LIGHT (pie de página; este es el valor por defecto)
